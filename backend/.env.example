ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://sandbox:sandbox@localhost:5432/sandbox

# Scan queue (Redis). Either REDIS_URL, or REDIS_HOST/REDIS_PORT/REDIS_DB
# (+ optional REDIS_USERNAME / REDIS_PASSWORD) when auth is required. Inside
# Docker use the service name: redis://sandbox_redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_QUEUE_NAME=sandbox:scans
REDIS_CONSUMER_GROUP=sandbox:workers
REDIS_VISIBILITY_TIMEOUT_S=600
REDIS_BLOCK_TIMEOUT_MS=5000
REDIS_BACKOFF_S=2

MAX_UPLOAD_MB=50

# Bounded Redis consumers; keep scanning concurrency bounded (default 4).
WORKER_MAX_THREADS=4