ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://sandbox:sandbox@localhost:5432/sandbox

# Scan queue (Redis). Either REDIS_URL, or REDIS_HOST/REDIS_PORT/REDIS_DB
# (+ optional REDIS_USERNAME / REDIS_PASSWORD) when auth is required. Inside
# Docker use the service name: redis://sandbox_redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_QUEUE_NAME=sandbox:scans
REDIS_CONSUMER_GROUP=sandbox:workers
REDIS_VISIBILITY_TIMEOUT_S=600
REDIS_BLOCK_TIMEOUT_MS=5000
REDIS_BACKOFF_S=2

MAX_UPLOAD_MB=50

# Secure File Access gateway (see DECISIONS.md D-16). TTL bounds how long a
# request may be delivered/browsed after access is granted.
SECURE_ACCESS_TTL_MINUTES=15

# Bounded Redis consumers; keep scanning concurrency bounded (default 4).
WORKER_MAX_THREADS=4

# Bounded QR visual analysis (PDF only). QR evidence does not alter verdicts.
QR_ENABLED=true
QR_MAX_PAGES=5
QR_RENDER_DPI=144
QR_MAX_PIXELS=4000000
QR_MAX_CODES=20
QR_TIMEOUT_S=10

# Threat Intelligence enrichment (see DECISIONS.md D-17). Evidence-only,
# DISABLED by default. Runs AFTER the deterministic verdict is persisted and
# never changes verdict/action/risk_score. API keys are env-only.
TI_ENABLED=true
TI_CACHE_TTL_SECONDS=3600
TI_MAX_INDICATORS_PER_SCAN=20
TI_MAX_RETRY_WAIT_S=10

# AbuseIPDB (CHECK only - SANDBox never reports users/IPs). Free key: 1000 req/day.
ABUSEIPDB_ENABLED=true
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_TIMEOUT_SECONDS=3
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_MIN_SPACING_S=1
ABUSEIPDB_MAX_REQUESTS_PER_DAY=1000

# VirusTotal API v3 (reputation lookups ONLY - no file upload, no URL submission).
# Public free-license conservative limits: 4 requests/minute, 500/day. The free
# public API is NOT suitable for commercial production (see D-17); a future
# licensed key only changes the limits below - no code change required.
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT_SECONDS=4
VIRUSTOTAL_MAX_REQUESTS_PER_MINUTE=4
VIRUSTOTAL_MAX_REQUESTS_PER_DAY=500
VIRUSTOTAL_MIN_SPACING_S=15
VIRUSTOTAL_LOOKUP_IP=true
VIRUSTOTAL_LOOKUP_URL=true
VIRUSTOTAL_LOOKUP_DOMAIN=true
VIRUSTOTAL_LOOKUP_SHA256=true
